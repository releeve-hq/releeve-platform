NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Contact form delivery. Resend takes precedence; Cloudflare is the fallback.
# CONTACT_EMAIL_TO defaults to the address inside EMAIL_FROM when omitted.
CONTACT_EMAIL_TO=team@example.com
EMAIL_FROM="Releeve <no-reply@releeve.xyz>"
RESEND_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
