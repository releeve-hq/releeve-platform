# ===== Server =====
BIND_ADDR=127.0.0.1:8080
LOG_FILTER=info,tower_http=info
APP_BASE_URL=http://localhost:3000
OAUTH_CALLBACK_BASE=http://localhost:8080

# ===== Postgres (matches docker-compose dev services) =====
DATABASE_URL=postgres://postgres:postgres@localhost:5432/releeve

# ===== Redis =====
REDIS_URL=redis://127.0.0.1:6379

# ===== Auth (Phase 1; declared now so .env stays stable) =====
JWT_SECRET=change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ===== Email / SMTP (Phase 1) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Releeve <no-reply@releeve.dev>"

# ===== OAuth (Phase 1) =====
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# ===== Ingest daemon (Phase 2; prefix INGEST_) =====
# Same Postgres/Redis as the API; the daemon just needs its own connection.
INGEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/releeve
INGEST_REDIS_URL=redis://127.0.0.1:6379
INGEST_NETWORK=testnet
# Dev upstreams (public testnet). Set to your own node for pubnet.
INGEST_HORIZON_URL=https://horizon-testnet.stellar.org
INGEST_RPC_URL=https://soroban-testnet.stellar.org
# External USD price source; empty disables price refresh (USD stays NULL).
INGEST_PRICE_FEED_URL=
INGEST_SYNC_INTERVAL_SECS=10
INGEST_ROLLUP_INTERVAL_SECS=300
INGEST_MAX_LEDGERS_PER_PASS=50
INGEST_LOCK_TTL_SECS=120

# ===== Fork Core (private service; required for simulator and environments) =====
# Keep Fork Core bound to a private network. The browser never calls it directly.
FORK_CORE_URL=http://127.0.0.1:8787
FORK_CORE_SIGNING_KEY_FILE=../fork-core/secrets/releeve-platform-ed25519-private.pem
FORK_CORE_SIGNING_KID=platform-current
FORK_CORE_ISSUER=releeve-platform
FORK_CORE_AUDIENCE=fork-core
