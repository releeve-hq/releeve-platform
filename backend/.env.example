# ===== Server =====
BIND_ADDR=127.0.0.1:8080
LOG_FILTER=info,tower_http=info

# ===== Postgres (matches docker-compose dev services) =====
DATABASE_URL=postgres://postgres:postgres@localhost:5432/releeve

# ===== Redis =====
REDIS_URL=redis://127.0.0.1:6379

# ===== Auth (Phase 1; declared now so .env stays stable) =====
JWT_SECRET=change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ===== Email / SMTP (Phase 1) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Releeve <no-reply@releeve.dev>

# ===== OAuth (Phase 1) =====
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
